{
  "name": "realmlib",
  "version": "1.1.0",
  "description": "A networking library for Realm of the Mad God in TypeScript",
  "type": "commonjs",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/core.d.ts",
      "require": "./lib/core.js",
      "default": "./lib/core.js"
    },
    "./protocol": {
      "types": "./lib/protocol.d.ts",
      "require": "./lib/protocol.js",
      "default": "./lib/protocol.js"
    },
    "./packets": {
      "types": "./lib/packets.d.ts",
      "require": "./lib/packets.js",
      "default": "./lib/packets.js"
    },
    "./models": {
      "types": "./lib/models.d.ts",
      "require": "./lib/models.js",
      "default": "./lib/models.js"
    },
    "./data": {
      "types": "./lib/data.d.ts",
      "require": "./lib/data.js",
      "default": "./lib/data.js"
    }
  },
  "typesVersions": {
    "*": {
      "core": [
        "lib/core.d.ts"
      ],
      "protocol": [
        "lib/protocol.d.ts"
      ],
      "packets": [
        "lib/packets.d.ts"
      ],
      "models": [
        "lib/models.d.ts"
      ],
      "data": [
        "lib/data.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "eslint \"{src,test}/**/*.ts\" \"scripts/**/*.cjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "mocha",
    "coverage:core": "c8 --all --include='src/io/**/*.ts' --include='src/crypto/**/*.ts' --include='src/packet-registry.ts' --include='src/data/parser.ts' --reporter=text --reporter=json-summary --check-coverage --lines=90 --statements=90 --branches=90 --functions=90 mocha",
    "benchmark:payload-copy": "node scripts/benchmark-payload-copy.cjs",
    "reconcile:exalt": "npm run build --silent && node scripts/reconcile-exalt.cjs",
    "docs:protocol": "npm run build --silent && node scripts/generate-protocol-completeness.cjs",
    "check:protocol:built": "node scripts/reconcile-exalt.cjs --strict protocol/exalt-current.json",
    "check:protocol": "npm run build --silent && npm run check:protocol:built",
    "api:update": "npm run build --silent && api-extractor run --local",
    "api:check:built": "node scripts/check-api-report.cjs",
    "api:check": "npm run build --silent && npm run api:check:built",
    "package:check:built": "publint && node scripts/package-smoke.cjs",
    "package:check": "npm run build --silent && npm run package:check:built",
    "check": "npm run typecheck && npm run typecheck:test && npm run lint && npm run format:check && npm run coverage:core && npm run build && npm run check:protocol:built && npm run api:check:built && npm run package:check:built",
    "prepare": "npm run build"
  },
  "files": [
    "lib/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rotmg-network/realmlib.git"
  },
  "author": "abrn",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rotmg-network/realmlib/issues"
  },
  "overrides": {
    "mocha": {
      "diff": "^8.0.3",
      "glob": "^13.0.6",
      "minimatch": "^10.2.5",
      "serialize-javascript": "^7.0.5"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.12",
    "@types/chai": "^4.2.22",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "c8": "^12.0.0",
    "chai": "^4.3.4",
    "eslint": "^10.8.0",
    "mocha": "^11.7.6",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
