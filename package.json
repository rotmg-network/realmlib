{
  "name": "realmlib",
  "version": "1.1.0",
  "description": "A networking library for Realm of the Mad God in TypeScript",
  "type": "commonjs",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "mocha",
    "reconcile:exalt": "npm run build --silent && node scripts/reconcile-exalt.cjs",
    "check:protocol": "npm run build --silent && node scripts/reconcile-exalt.cjs --strict protocol/exalt-current.json",
    "api:update": "npm run build --silent && api-extractor run --local",
    "api:check": "npm run build --silent && api-extractor run",
    "package:check": "npm run build --silent && publint",
    "check": "npm run typecheck && npm run typecheck:test && npm run lint && npm test && npm run check:protocol && npm run api:check && npm run package:check",
    "prepare": "npm run build"
  },
  "files": [
    "lib/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rotmg-network/realmlib.git"
  },
  "author": "abrn",
  "bugs": {
    "url": "https://github.com/rotmg-network/realmlib/issues"
  },
  "overrides": {
    "mocha": {
      "diff": "^8.0.3",
      "glob": "^13.0.6",
      "minimatch": "^10.2.5",
      "serialize-javascript": "^7.0.5"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.12",
    "@types/chai": "^4.2.22",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "chai": "^4.3.4",
    "eslint": "^10.8.0",
    "mocha": "^11.7.6",
    "publint": "^0.3.22",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
